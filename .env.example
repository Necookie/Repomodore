# Turso Cloud Sync (server-side only)
TURSO_DATABASE_URL=libsql://repomodore-necookie.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=placeholder_turso_auth_token

# Sync API Configuration
EXPO_PUBLIC_SYNC_API_URL=http://localhost:3001
PORT=3001
